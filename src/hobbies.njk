---
layout: layouts/base.njk
title: Hobbies
description: What Erik Gunderson does when he isn't building Android apps.
---
{# Each hobby is a Markdown file in src/content/hobbies/ with a `photos` list in its front matter. #}
<h1 class="page-title">Hobbies</h1>

{%- for hobby in collections.hobbies | sort(false, false, "data.order") %}
<section class="card hobby" aria-labelledby="hobby-{{ loop.index }}">
  <h2 id="hobby-{{ loop.index }}">{{ hobby.data.title }}</h2>
  <div class="prose">{{ hobby.content | safe }}</div>
  {% if hobby.data.photos %}
  <div class="gallery">
    {%- for photo in hobby.data.photos %}
    <figure{% if photo.position %} style="--pos: {{ photo.position }}"{% endif %}>
      {# sizes ≈ how wide each photo renders: full width on phones, ~half on tablets, ~1/3 on desktop. #}
      {% image photo.src, photo.alt, "(min-width: 1100px) 340px, (min-width: 600px) 45vw, 90vw", [400, 800, 1200] %}
      {% if photo.caption %}<figcaption>{{ photo.caption }}</figcaption>{% endif %}
    </figure>
    {%- endfor %}
  </div>
  {% endif %}
</section>
{%- endfor %}
